{
  "name": "@exegia/corpora-ui",
  "version": "3.0.0",
  "description": "shadcn-ready React UI library for the corpora manuscript-research apps.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/exegia/corpora-ui.git"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "module": "./dist-lib/index.js",
  "types": "./dist-lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/index.d.ts",
      "import": "./dist-lib/index.js"
    },
    "./button": {
      "types": "./dist-lib/components/ui/button.d.ts",
      "import": "./dist-lib/button.js"
    },
    "./card": {
      "types": "./dist-lib/components/ui/card.d.ts",
      "import": "./dist-lib/card.js"
    },
    "./input": {
      "types": "./dist-lib/components/ui/input.d.ts",
      "import": "./dist-lib/input.js"
    },
    "./label": {
      "types": "./dist-lib/components/ui/label.d.ts",
      "import": "./dist-lib/label.js"
    },
    "./state": {
      "types": "./dist-lib/lib/state/index.d.ts",
      "import": "./dist-lib/state.js"
    },
    "./overlays": {
      "types": "./dist-lib/components/ui/overlays.d.ts",
      "import": "./dist-lib/overlays.js"
    },
    "./index.css": "./dist-lib/index.css",
    "./package.json": "./package.json",
    "./shell": {
      "types": "./dist-lib/components/blocks/shell/index.d.ts",
      "import": "./dist-lib/shell.js"
    },
    "./scaffold": {
      "types": "./dist-lib/components/blocks/scaffold/index.d.ts",
      "import": "./dist-lib/scaffold.js"
    }
  },
  "files": [
    "dist-lib"
  ],
  "scripts": {
    "dev": "fumapress dev",
    "build": "tsc -b && fumapress build && bun run build:lib",
    "build:docs": "fumapress build",
    "build:lib": "vite build --config vite.lib.config.ts",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "test": "bun test",
    "typecheck": "tsc -b --noEmit",
    "preview": "fumapress start",
    "sync:example": "bun run build:lib && bun install --frozen-lockfile",
    "dev:example": "bun run sync:example && bun run --filter @exegia/corpora-ui-consumer dev",
    "build:example": "bun run sync:example && bun run --filter @exegia/corpora-ui-consumer build",
    "check:consumer": "bun run build:lib && bun scripts/check-consumer.ts"
  },
  "peerDependencies": {
    "jotai": "^3.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@exegia/specular": "^0.1.2",
    "@omsimos/react-highlight-popover": "^1.4.1",
    "@remixicon/react": "^4.9.0",
    "@samasante/liquid-glass": "^0.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.6",
    "cuelume": "^0.2.2",
    "echarts": "^6.1.0",
    "frimousse": "^0.3.0",
    "iconsax-reactjs": "^0.0.8",
    "lucide": "^1.45.0",
    "lucide-react": "^1.45.0",
    "morphicons": "^1.7.1",
    "motion": "^13.2.0",
    "motion-icons-react": "^1.1.0",
    "motion-panels": "^0.5.2",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fumadocs/story": "^1.3.0",
    "@happy-dom/global-registrator": "^20.14.5",
    "@tailwindcss/vite": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bun": "^1.3.14",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "fumadocs-core": "^16.15.10",
    "fumadocs-mdx": "^15.4.0",
    "fumadocs-ui": "npm:@fumadocs/base-ui@^16.15.10",
    "fumapress": "^1.3.0",
    "globals": "^17",
    "jotai": "catalog:",
    "mermaid": "^12.0.0",
    "next-themes": "^0.4.6",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shadcn": "^4.21.0",
    "tailwind-animations": "^1.0.2",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8",
    "vite": "catalog:",
    "vite-plugin-dts": "^5.1.0"
  },
  "workspaces": [
    "examples/consumer"
  ],
  "catalog": {
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "jotai": "^3.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/node": "^24",
    "typescript": "~6",
    "vite": "^8.2.2",
    "@vitejs/plugin-react": "^6"
  }
}
