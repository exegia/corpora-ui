{
  "name": "@exegia/corpora-ui",
  "version": "0.7.0",
  "description": "shadcn-ready React UI library for the corpora manuscript-research apps.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/exegia/corpora-ui.git"
  },
  "type": "module",
  "sideEffects": false,
  "module": "./dist-lib/index.js",
  "types": "./dist-lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/index.d.ts",
      "import": "./dist-lib/index.js"
    },
    "./index.css": "./src/index.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist-lib",
    "src/components",
    "src/lib",
    "src/index.css",
    "src/index.ts"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && bun run build:lib",
    "build:lib": "vite build --config vite.lib.config.ts",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "test": "bun test",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@remixicon/react": "^4.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cuelume": "^0.2.1",
    "lucide-react": "^1.27.0",
    "motion": "^12.43.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@happy-dom/global-registrator": "^20.11.1",
    "@tailwindcss/vite": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router": "^8.3.0",
    "shadcn": "^4.16.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vite-plugin-dts": "^5.0.3"
  }
}
